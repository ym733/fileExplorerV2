<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">

  <div class="user-actions-card position-relative text-center p-5 rounded-3">

    <button id="back-btn" type="button" class="btn btn-link position-absolute top-0 start-0 m-3 d-none" onclick="showDefaultPanel()">
        <i class="fa-solid fa-angle-left fa-lg"></i>
    </button>

    <!-- Default: two action buttons -->
    <div id="default-panel">
      <h4 class="mb-4">User Actions</h4>
      <div class="d-grid gap-3">
        <button type="button" class="btn btn-action" onclick="showResetPasswordPanel()">Reset User Password</button>
        <%= button_to "Add MFA Phone",
            "/setup/get_MFA_QR",
            method: :post,
            class: "btn btn-action w-100",
            onclick: "showMfaPanel()",
            form: { data: { turbo_frame: "mfa_qr_frame" } }
        %>
      </div>
    </div>

    <!-- Reset password form -->
    <div id="reset-password-panel" class="d-none text-start">
      <h4 class="mb-4 text-center">Reset Password</h4>
      <%= form_with url: "/setup/reset_user_password", method: :post, local: true do |f| %>
        <div class="mb-3">
          <label class="form-label">New Password</label>
          <%= f.password_field :password, class: "form-control", required: true %>
        </div>
        <div class="mb-3">
          <label class="form-label">Confirm Password</label>
          <%= f.password_field :password_confirmation, class: "form-control", required: true %>
        </div>
        <%= f.submit "Submit", class: "btn btn-action w-100" %>
      <% end %>
    </div>

    <!-- MFA QR, loaded via Turbo Frame -->
    <div id="mfa-panel-wrapper" class="d-none">
      <turbo-frame id="mfa_qr_frame">
        <p class="text-muted">Loading...</p>
      </turbo-frame>
    </div>

  </div>
</div>

<script>
  function showDefaultPanel() {
    document.getElementById('default-panel').classList.remove('d-none');
    document.getElementById('reset-password-panel').classList.add('d-none');
    document.getElementById('mfa-panel-wrapper').classList.add('d-none');
    document.getElementById('back-btn').classList.add('d-none');
  }

  function showResetPasswordPanel() {
    document.getElementById('default-panel').classList.add('d-none');
    document.getElementById('reset-password-panel').classList.remove('d-none');
    document.getElementById('back-btn').classList.remove('d-none');
  }

  function showMfaPanel() {
    document.getElementById('default-panel').classList.add('d-none');
    document.getElementById('mfa-panel-wrapper').classList.remove('d-none');
    document.getElementById('back-btn').classList.remove('d-none');
  }
</script>

<style>
  .user-actions-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    box-shadow: 0 0.5rem 1rem var(--shadow-color);
    min-width: 340px;
  }

  .user-actions-card h4 {
    color: var(--text-primary);
  }

  .form-label {
    color: var(--text-secondary);
  }

  .form-control {
    background-color: var(--bg-primary);
    border-color: var(--border-color);
    color: var(--text-primary);
  }

  .form-control:focus {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    border-color: var(--selected-border);
    box-shadow: 0 0 0 0.2rem var(--selected-bg);
  }

  .btn-action {
    background-color: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.75rem 1.5rem;
    font-weight: 500;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .btn-action:hover {
    background-color: var(--hover-bg);
    border-color: var(--selected-border);
    color: var(--text-primary);
  }

  #back-btn {
    color: var(--text-secondary);
  }

  #back-btn:hover {
    color: var(--text-primary);
  }
</style>
